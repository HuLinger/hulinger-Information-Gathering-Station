# Production: domain only, and the matching HTTPS origin (no path).
SITE_DOMAIN=hub.example.com
APP_URL=https://hub.example.com

# Generate each value independently with: openssl rand -hex 32
# Keep .env mode 600. Do not reuse these values or upload .env to Git.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
BETTER_AUTH_SECRET=

# Optional token for public GitHub API quota. No repository write permission needed.
GITHUB_TOKEN=

# Optional immutable application image; default builds from this checkout.
HULINGER_IMAGE=hulinger-hub:local

# Private drive: decimal bytes. Default single file 1 TiB; 0 means no extra quota.
# Disk availability is still enforced, including ongoing uploads and a 1 GiB reserve.
DRIVE_MAX_FILE_BYTES=1099511627776
DRIVE_QUOTA_BYTES=0
DRIVE_RESERVE_BYTES=1073741824
DRIVE_MAX_PARALLEL=8
# Upload chunk size 16 MiB; supported range is validated by the application (max 32 MiB).
DRIVE_CHUNK_BYTES=16777216

# Local development only; Compose overrides database connections per service.
# Keep APP_URL equal to the local dev server origin and port when developing.
DATABASE_URL=
## 格式转换（仅服务端使用；四个引擎为空时页面显示尚未启用）
# Windows 原生 web/worker 填稳定绝对目录，两个服务使用同一路径。
CONVERSION_STORAGE_PATH=data/conversion
CONVERSION_MAX_INPUT_BYTES=536870912
CONVERSION_MAX_OUTPUT_BYTES=1073741824
CONVERSION_ACCOUNT_QUOTA_BYTES=5368709120
CONVERSION_RESERVE_BYTES=1073741824
CONVERSION_TIMEOUT_SECONDS=900
# 引擎配置由 scripts/setup-converters.mjs 生成；不得暴露到浏览器。
CONVERTX_URL=
TRANSMUTE_URL=
TRANSMUTE_API_KEY=
STIRLING_PDF_URL=
NCMDUMP_URL=
