# Production: domain only, and the matching HTTPS origin (no path).
SITE_DOMAIN=hub.example.com
APP_URL=https://hub.example.com

# Generate each value independently with: openssl rand -hex 32
# Keep .env mode 600. Do not reuse these values or upload .env to Git.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
BETTER_AUTH_SECRET=

# Optional token for public GitHub API quota. No repository write permission needed.
GITHUB_TOKEN=

# Optional immutable application image; default builds from this checkout.
HULINGER_IMAGE=hulinger-hub:local

# Local development only; Compose overrides database connections per service.
# Keep APP_URL equal to the local dev server origin and port when developing.
DATABASE_URL=
