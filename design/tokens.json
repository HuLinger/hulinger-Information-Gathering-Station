{
  "metadata": {
    "name": "Hulinger UI tokens",
    "version": 1,
    "updatedAt": "2026-11-04",
    "designSystem": "Ant Design",
    "status": "baseline-not-yet-integrated",
    "defaultTheme": "light",
    "darkThemeStatus": "reserved-until-verified",
    "units": "px unless otherwise specified"
  },
  "spacing": [0, 4, 8, 12, 16, 24, 32, 48, 64],
  "radius": { "small": 4, "default": 6, "large": 8 },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "caption": { "fontSize": 12, "lineHeight": 20 },
    "body": { "fontSize": 14, "lineHeight": 22 },
    "reading": { "fontSize": 16, "lineHeight": 26 },
    "sectionTitle": { "fontSize": 20, "lineHeight": 28, "fontWeight": 600 },
    "pageTitle": { "fontSize": 24, "lineHeight": 32, "fontWeight": 600 }
  },
  "layout": {
    "headerHeight": 56,
    "sidebarWidth": 232,
    "contentMaxWidth": 1440,
    "readingMaxWidth": 760,
    "mobileGutter": 16,
    "desktopGutter": 24,
    "breakpoints": { "tablet": 768, "desktop": 1024, "wide": 1440 }
  },
  "controls": {
    "defaultHeight": 40,
    "compactHeight": 32,
    "touchTargetMin": 44,
    "focusOutlineWidth": 2,
    "focusOutlineOffset": 2
  },
  "motion": { "fastMs": 120, "normalMs": 200, "reducedMotionMs": 0 },
  "themes": {
    "light": {
      "canvas": "#f5f5f5",
      "surface": "#ffffff",
      "surfaceRaised": "#ffffff",
      "textPrimary": "#1f1f1f",
      "textSecondary": "#595959",
      "textDisabled": "#8c8c8c",
      "borderDecorative": "#d9d9d9",
      "borderInteractive": "#8c8c8c",
      "primary": "#0958d9",
      "primaryHover": "#003eb3",
      "primaryActive": "#002c8c",
      "onPrimary": "#ffffff",
      "focus": "#0958d9",
      "success": "#237804",
      "warning": "#874d00",
      "danger": "#cf1322",
      "selectedSurface": "#e6f4ff"
    },
    "dark": {
      "canvas": "#000000",
      "surface": "#141414",
      "surfaceRaised": "#1f1f1f",
      "textPrimary": "#f5f5f5",
      "textSecondary": "#bfbfbf",
      "textDisabled": "#737373",
      "borderDecorative": "#434343",
      "borderInteractive": "#8c8c8c",
      "primary": "#85b8ff",
      "primaryHover": "#adcfff",
      "primaryActive": "#69a5f5",
      "onPrimary": "#141414",
      "focus": "#85b8ff",
      "success": "#95de64",
      "warning": "#ffd666",
      "danger": "#ff7875",
      "selectedSurface": "#112a45"
    }
  },
  "contrastPairs": [
    { "foreground": "textPrimary", "background": "surface", "minRatio": 4.5 },
    { "foreground": "textPrimary", "background": "canvas", "minRatio": 4.5 },
    { "foreground": "textPrimary", "background": "surfaceRaised", "minRatio": 4.5 },
    { "foreground": "textSecondary", "background": "surface", "minRatio": 4.5 },
    { "foreground": "textSecondary", "background": "canvas", "minRatio": 4.5 },
    { "foreground": "textSecondary", "background": "surfaceRaised", "minRatio": 4.5 },
    { "foreground": "textPrimary", "background": "selectedSurface", "minRatio": 4.5 },
    { "foreground": "primary", "background": "surface", "minRatio": 4.5 },
    { "foreground": "onPrimary", "background": "primary", "minRatio": 4.5 },
    { "foreground": "onPrimary", "background": "primaryHover", "minRatio": 4.5 },
    { "foreground": "onPrimary", "background": "primaryActive", "minRatio": 4.5 },
    { "foreground": "success", "background": "surface", "minRatio": 4.5 },
    { "foreground": "warning", "background": "surface", "minRatio": 4.5 },
    { "foreground": "danger", "background": "surface", "minRatio": 4.5 },
    { "foreground": "borderInteractive", "background": "surface", "minRatio": 3 },
    { "foreground": "focus", "background": "surface", "minRatio": 3 },
    { "foreground": "focus", "background": "canvas", "minRatio": 3 }
